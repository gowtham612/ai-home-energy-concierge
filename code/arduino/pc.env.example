# Run uno_q_publisher.py ON THE PC instead of on the board.
# Copy to pc.env and edit for your network. pc.env is gitignored.
#
# WHY YOU MIGHT WANT THIS
# The publisher normally runs on the UNO Q, which is the better Archetype E
# story (the board drives the physical action). But it needs the board to be on
# the same LAN as the Kasa devices, and board Wi-Fi is the most fragile part of
# a venue setup — it will happily auto-join a saved network that is not yours.
#
# Running it on the PC removes that dependency completely:
#   MCU telemetry  -> over USB via `adb forward tcp:7500 tcp:7500`
#   MQTT broker    -> localhost
#   Kasa devices   -> whatever network the PC is on
# The board then needs no Wi-Fi at all, only the USB cable.
#
# SETUP
#   adb forward tcp:7500 tcp:7500
#   cd code/arduino && set -a && . ./pc.env && set +a
#   ../.venv/Scripts/python.exe uno_q_publisher.py

# Broker and hub are on this machine.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
ROOM=living

# The MCU's Serial, tunnelled over USB by `adb forward`. These are the defaults;
# they are spelled out here so it is obvious where the telemetry comes from.
MCU_TCP_HOST=127.0.0.1
MCU_TCP_PORT=7500

# Who owns which sensor signal. The hub merges room state, so the last writer of
# a key wins and the MCU's 1 Hz stream beats anything POSTed to /api/sensor.
#   temp_c  -> the Modulino Knob owns temperature. Turn it past 27 C to make the
#              R7 comfort guardrail refuse an A/C shutoff. THIS IS THE DEMO.
#   (empty) -> MCU publishes nothing; the simulator owns every signal.
MCU_SIGNALS=temp_c

# Kasa devices. Quote any value containing spaces.
# Find current IPs with:  .venv/Scripts/kasa.exe discover
KASA_AC_HOST=172.20.10.5
KASA_AC_ALIAS="Space heater"

# The bulb — fill in once it has joined the network.
# KASA_LIGHTS_HOST=172.20.10.x
KASA_LIGHTS_ALIAS="Bedroom light 2"

# Loads the rules recognise: lights, ac, heater, standby, dryer, dishwasher.
# A load named anything else is ignored by every rule — see board.env.example.
KASA_LOADS=lights,ac

KASA_POLL_S=5
KASA_DISCOVER_S=8
KASA_SETTLE_S=0.4
